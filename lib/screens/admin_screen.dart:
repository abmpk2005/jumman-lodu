import 'package:flutter/material.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

class AdminScreen extends StatefulWidget {
  const AdminScreen({super.key});
  @override
  State<AdminScreen> createState() => _AdminScreenState();
}

class _AdminScreenState extends State<AdminScreen> with SingleTickerProviderStateMixin {
  late TabController _adminTabCtrl;
  String _playerSearchQuery = "";

  @override
  void initState() {
    super.initState();
    _adminTabCtrl = TabController(length: 3, vsync: this);
  }

  void _showPlayerEditDialog(Map<String, dynamic> player) {
    final nameCtrl = TextEditingController(text: player['full_name'] ?? '');
    final balanceAmountCtrl = TextEditingController();
    bool isBanned = player['is_banned'] ?? false;
    final supabase = Supabase.instance.client;

    showDialog(
      context: context,
      builder: (ctx) => StatefulBuilder(
        builder: (context, setDialogState) {
          return AlertDialog(
            backgroundColor: const Color(0xFF35042D),
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20), side: const BorderSide(color: Colors.amber)),
            title: Text("${player['full_name']} (কন্ট্রোল)", style: const TextStyle(color: Colors.amber, fontWeight: FontWeight.bold, fontSize: 18)),
            content: SingleChildScrollView(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text("ফোন: ${player['phone_number']}", style: const TextStyle(color: Colors.white70, fontSize: 13)),
                  Text("আইডি: ${player['player_id']}", style: const TextStyle(color: Colors.white70, fontSize: 13)),
                  Text("মোট ম্যাচ: ${player['total_matches'] ?? 0} | জয়: ${player['matches_won'] ?? 0}", style: const TextStyle(color: Colors.greenAccent, fontSize: 13)),
                  const Divider(color: Colors.white24, height: 20),
                  TextField(
                    controller: nameCtrl,
                    style: const TextStyle(color: Colors.white),
                    decoration: const InputDecoration(labelText: "প্লেয়ারের নাম পরিবর্তন", labelStyle: TextStyle(color: Colors.white60)),
                  ),
                  const SizedBox(height: 12),
                  TextField(
                    controller: balanceAmountCtrl,
                    keyboardType: TextInputType.number,
                    style: const TextStyle(color: Colors.white),
                    decoration: const InputDecoration(labelText: "ব্যালেন্স যোগ/বিয়োগ পরিমাণ (৳)", labelStyle: TextStyle(color: Colors.white60)),
                  ),
                  const SizedBox(height: 16),
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      const Text("অ্যাকাউন্ট স্ট্যাটাস:", style: TextStyle(color: Colors.white)),
                      ElevatedButton(
                        style: ElevatedButton.styleFrom(backgroundColor: isBanned ? Colors.green : Colors.redAccent),
                        onPressed: () async {
                          bool newStatus = !isBanned;
                          await supabase.from('profiles').update({'is_banned': newStatus}).eq('id', player['id']);
                          setDialogState(() => isBanned = newStatus);
                          ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(newStatus ? "প্লেয়ার ব্লক করা হয়েছে!" : "প্লেয়ার আনব্লক করা হয়েছে!")));
                        },
                        child: Text(isBanned ? "আনব্লক করুন" : "ব্লক করুন", style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
                      ),
                    ],
                  ),
                ],
              ),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(ctx),
                child: const Text("বাতিল", style: TextStyle(color: Colors.white60)),
              ),
              ElevatedButton(
                style: ElevatedButton.styleFrom(backgroundColor: Colors.amber),
                onPressed: () async {
                  if (nameCtrl.text.trim().isNotEmpty) {
                    await supabase.from('profiles').update({'full_name': nameCtrl.text.trim()}).eq('id', player['id']);
                  }
                  double change = double.tryParse(balanceAmountCtrl.text) ?? 0.0;
                  if (change != 0.0) {
                    final wallet = await supabase.from('wallet_accounts').select().eq('user_id', player['id']).maybeSingle();
                    if (wallet != null) {
                      double current = double.parse((wallet['balance'] ?? 0.0).toString());
                      await supabase.from('wallet_accounts').update({'balance': current + change}).eq('user_id', player['id']);
                    }
                  }
                  Navigator.pop(ctx);
                  ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text("তথ্য সফলভাবে আপডেট হয়েছে!")));
                },
                child: const Text("সংরক্ষণ করুন", style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold)),
              ),
            ],
          );
        },
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final supabase = Supabase.instance.client;
    return Scaffold(
      appBar: AppBar(
        title: const Text("অ্যাডমিন মাস্টার কন্ট্রোল"),
        backgroundColor: const Color(0xFF4A0A3A),
        bottom: TabBar(
          controller: _adminTabCtrl,
          indicatorColor: Colors.amber,
          tabs: const [Tab(text: "জমা"), Tab(text: "উত্তোলন"), Tab(text: "খেলোয়াড়বৃন্দ")],
        ),
      ),
      body: TabBarView(
        controller: _adminTabCtrl,
        children: [
          // জমা
          StreamBuilder<List<Map<String, dynamic>>>(
            stream: supabase.from('deposit_requests').stream(primaryKey: ['id']).eq('status', 'PENDING'),
            builder: (context, snapshot) {
              if (!snapshot.hasData) return const Center(child: CircularProgressIndicator());
              final list = snapshot.data!;
              if (list.isEmpty) return const Center(child: Text("কোনো পেন্ডিং জমা অনুরোধ নেই!"));

              return ListView.builder(
                itemCount: list.length,
                itemBuilder: (context, i) {
                  final req = list[i];
                  return Card(
                    color: const Color(0xFF35042D),
                    margin: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12), side: const BorderSide(color: Colors.amber)),
                    child: ListTile(
                      title: Text("৳${req['amount']} (${req['payment_method']})", style: const TextStyle(color: Colors.greenAccent, fontWeight: FontWeight.bold)),
                      subtitle: Text("প্রেরক: ${req['sender_number']}\nTrxID: ${req['trx_id']}"),
                      trailing: Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          IconButton(
                            icon: const Icon(Icons.check_circle, color: Colors.greenAccent, size: 30),
                            onPressed: () async {
                              await supabase.rpc('approve_deposit_transaction', params: {
                                'p_req_id': req['id'],
                                'p_user_id': req['user_id'].toString(),
                                'p_amount': req['amount'],
                              });
                            },
                          ),
                          IconButton(
                            icon: const Icon(Icons.cancel, color: Colors.redAccent, size: 30),
                            onPressed: () async {
                              await supabase.from('deposit_requests').update({'status': 'REJECTED'}).eq('id', req['id']);
                            },
                          ),
                        ],
                      ),
                    ),
                  );
                },
              );
            },
          ),
          // উত্তোলন
          StreamBuilder<List<Map<String, dynamic>>>(
            stream: supabase.from('withdrawal_requests').stream(primaryKey: ['id']).eq('status', 'PENDING'),
            builder: (context, snapshot) {
              if (!snapshot.hasData) return const Center(child: CircularProgressIndicator());
              final list = snapshot.data!;
              if (list.isEmpty) return const Center(child: Text("কোনো পেন্ডিং উত্তোলন অনুরোধ নেই!"));

              return ListView.builder(
                itemCount: list.length,
                itemBuilder: (context, i) {
                  final req = list[i];
                  return Card(
                    color: const Color(0xFF35042D),
                    margin: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12), side: const BorderSide(color: Colors.blueAccent)),
                    child: ListTile(
                      title: Text("টাকা: ৳${req['amount']}", style: const TextStyle(color: Colors.amberAccent, fontWeight: FontWeight.bold)),
                      subtitle: Text("নম্বর: ${req['receiver_number']}"),
                      trailing: Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          IconButton(
                            icon: const Icon(Icons.check_circle, color: Colors.greenAccent, size: 30),
                            onPressed: () async {
                              await supabase.rpc('approve_withdrawal_transaction', params: {
                                'p_req_id': req['id'],
                                'p_user_id': req['user_id'].toString(),
                                'p_amount': req['amount'],
                              });
                            },
                          ),
                          IconButton(
                            icon: const Icon(Icons.cancel, color: Colors.redAccent, size: 30),
                            onPressed: () async {
                              await supabase.from('withdrawal_requests').update({'status': 'REJECTED'}).eq('id', req['id']);
                            },
                          ),
                        ],
                      ),
                    ),
                  );
                },
              );
            },
          ),
          // খেলোয়াড় কন্ট্রোল
          Column(
            children: [
              Padding(
                padding: const EdgeInsets.all(10.0),
                child: TextField(
                  style: const TextStyle(color: Colors.white),
                  onChanged: (val) => setState(() => _playerSearchQuery = val.trim().toLowerCase()),
                  decoration: InputDecoration(
                    hintText: "ফোন নম্বর বা নাম দিয়ে খুঁজুন...",
                    hintStyle: const TextStyle(color: Colors.white54),
                    prefixIcon: const Icon(Icons.search, color: Colors.amber),
                    filled: true,
                    fillColor: const Color(0xFF35042D),
                    border: OutlineInputBorder(borderRadius: BorderRadius.circular(14), borderSide: const BorderSide(color: Colors.amber)),
                  ),
                ),
              ),
              Expanded(
                child: StreamBuilder<List<Map<String, dynamic>>>(
                  stream: supabase.from('profiles').stream(primaryKey: ['id']),
                  builder: (context, snapshot) {
                    if (!snapshot.hasData) return const Center(child: CircularProgressIndicator());
                    final allPlayers = snapshot.data!;
                    
                    final filtered = allPlayers.where((p) {
                      final name = (p['full_name'] ?? '').toString().toLowerCase();
                      final phone = (p['phone_number'] ?? '').toString().toLowerCase();
                      return name.contains(_playerSearchQuery) || phone.contains(_playerSearchQuery);
                    }).toList();

                    if (filtered.isEmpty) return const Center(child: Text("কোনো খেলোয়াড় পাওয়া যায়নি!"));

                    return ListView.builder(
                      itemCount: filtered.length,
                      itemBuilder: (context, i) {
                        final p = filtered[i];
                        final bool isBanned = p['is_banned'] ?? false;

                        return Card(
                          color: const Color(0xFF35042D),
                          margin: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
                          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12), side: BorderSide(color: isBanned ? Colors.redAccent : Colors.white12)),
                          child: ListTile(
                            leading: CircleAvatar(
                              backgroundColor: isBanned ? Colors.red : Colors.amber,
                              child: Text(p['full_name'] != null && p['full_name'].toString().isNotEmpty ? p['full_name'][0] : 'P', style: TextStyle(color: isBanned ? Colors.white : Colors.black, fontWeight: FontWeight.bold)),
                            ),
                            title: Row(
                              children: [
                                Text("${p['full_name']}", style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.white)),
                                const SizedBox(width: 6),
                                if (isBanned)
                                  Container(
                                    padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                                    decoration: BoxDecoration(color: Colors.red, borderRadius: BorderRadius.circular(6)),
                                    child: const Text("ব্লকড", style: TextStyle(color: Colors.white, fontSize: 10, fontWeight: FontWeight.bold)),
                                  ),
                              ],
                            ),
                            subtitle: Text("ফোন: ${p['phone_number']} | আইডি: ${p['player_id']}\nম্যাচ: ${p['total_matches'] ?? 0} | জয়: ${p['matches_won'] ?? 0}", style: const TextStyle(color: Colors.white70, fontSize: 12)),
                            trailing: ElevatedButton(
                              style: ElevatedButton.styleFrom(backgroundColor: const Color(0xFF4A0A3A), side: const BorderSide(color: Colors.amber)),
                              onPressed: () => _showPlayerEditDialog(p),
                              child: const Text("কন্ট্রোল", style: TextStyle(color: Colors.amberAccent, fontSize: 12, fontWeight: FontWeight.bold)),
                            ),
                          ),
                        );
                      },
                    );
                  },
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
}
