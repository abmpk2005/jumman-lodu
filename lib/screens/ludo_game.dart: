import 'dart:async';
import 'dart:math';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

class RealLudoEngineScreen extends StatefulWidget {
  final double entryFee;
  final String userId;
  final String phone;
  final String playerName;
  const RealLudoEngineScreen({super.key, required this.entryFee, required this.userId, required this.phone, required this.playerName});

  @override
  State<RealLudoEngineScreen> createState() => _RealLudoEngineScreenState();
}

class _RealLudoEngineScreenState extends State<RealLudoEngineScreen> with TickerProviderStateMixin {
  int _playerDice = 1;
  int _opponentDice = 1;
  int _displayPlayerDice = 1;
  int _displayOpponentDice = 1;

  bool _isPlayerRolling = false;
  bool _isOpponentRolling = false;
  bool _waitingForPawnTap = false;
  bool _isMovingStepByStep = false;
  int _turn = 0; // 0 = Player (Yellow), 1 = Opponent (Red)
  List<int> _movablePawns = [];

  List<int> yellowPawns = [-1, -1, -1, -1];
  List<int> redPawns = [-1, -1, -1, -1];

  final Set<int> safeGlobalTiles = {1, 9, 14, 22, 27, 35, 40, 48};

  Timer? _turnCountdownTimer;
  int _secondsLeft = 15;

  late AnimationController _glowCtrl;
  late AnimationController _playerDiceRotCtrl;
  late AnimationController _opponentDiceRotCtrl;

  String _turnStatus = "👉 আপনার চাল! ছক্কায় ট্যাপ করুন";

  static const List<Point<int>> trackPoints = [
    Point(8, 0), Point(8, 1), Point(8, 2), Point(8, 3), Point(8, 4), Point(8, 5),
    Point(9, 6), Point(10, 6), Point(11, 6), Point(12, 6), Point(13, 6), Point(14, 6),
    Point(14, 7),
    Point(14, 8), Point(13, 8), Point(12, 8), Point(11, 8), Point(10, 8), Point(9, 8),
    Point(8, 9), Point(8, 10), Point(8, 11), Point(8, 12), Point(8, 13), Point(8, 14),
    Point(7, 14),
    Point(6, 14), Point(6, 13), Point(6, 12), Point(6, 11), Point(6, 10), Point(6, 9),
    Point(5, 8), Point(4, 8), Point(3, 8), Point(2, 8), Point(1, 8), Point(0, 8),
    Point(0, 7),
    Point(0, 6), Point(1, 6), Point(2, 6), Point(3, 6), Point(4, 6), Point(5, 6),
    Point(6, 5), Point(6, 4), Point(6, 3), Point(6, 2), Point(6, 1), Point(6, 0),
    Point(7, 0),
  ];

  @override
  void initState() {
    super.initState();
    _deductEntryFee();
    _glowCtrl = AnimationController(vsync: this, duration: const Duration(milliseconds: 550))..repeat(reverse: true);
    _playerDiceRotCtrl = AnimationController(vsync: this, duration: const Duration(milliseconds: 550));
    _opponentDiceRotCtrl = AnimationController(vsync: this, duration: const Duration(milliseconds: 550));
    _startTurnTimer();
  }

  @override
  void dispose() {
    _turnCountdownTimer?.cancel();
    _glowCtrl.dispose();
    _playerDiceRotCtrl.dispose();
    _opponentDiceRotCtrl.dispose();
    super.dispose();
  }

  void _startTurnTimer() {
    _turnCountdownTimer?.cancel();
    setState(() => _secondsLeft = 15);
    _turnCountdownTimer = Timer.periodic(const Duration(seconds: 1), (timer) {
      if (_secondsLeft > 0) {
        setState(() => _secondsLeft--);
      } else {
        timer.cancel();
        if (_turn == 0) {
          if (_waitingForPawnTap && _movablePawns.isNotEmpty) {
            _onSelectPlayerPawn(_movablePawns.first);
          } else {
            _passTurnToOpponent();
          }
        }
      }
    });
  }

  Future<void> _deductEntryFee() async {
    if (widget.entryFee <= 0) return;
    try {
      final supabase = Supabase.instance.client;
      final wallet = await supabase.from('wallet_accounts').select().eq('user_id', widget.userId).single();
      double cur = double.parse((wallet['balance'] ?? 0.0).toString());
      await supabase.from('wallet_accounts').update({'balance': cur - widget.entryFee}).eq('user_id', widget.userId);
    } catch (_) {}
  }

  Future<void> _recordWin() async {
    try {
      final supabase = Supabase.instance.client;
      final wallet = await supabase.from('wallet_accounts').select().eq('user_id', widget.userId).single();
      double cur = double.parse((wallet['balance'] ?? 0.0).toString());
      double prize = widget.entryFee * 1.8;
      await supabase.from('wallet_accounts').update({'balance': cur + prize}).eq('user_id', widget.userId);
    } catch (_) {}
  }

  void _rollPlayerDice() {
    if (_isPlayerRolling || _waitingForPawnTap || _isMovingStepByStep || _turn != 0) return;
    HapticFeedback.mediumImpact();
    
    setState(() {
      _isPlayerRolling = true;
      _turnStatus = "🎲 ছক্কা ঘুরছে...";
    });
    _playerDiceRotCtrl.forward(from: 0.0);

    int count = 0;
    Timer.periodic(const Duration(milliseconds: 50), (timer) {
      count++;
      setState(() => _displayPlayerDice = Random().nextInt(6) + 1);
      if (count >= 10) {
        timer.cancel();
        final finalRoll = Random().nextInt(6) + 1;
        setState(() {
          _playerDice = finalRoll;
          _displayPlayerDice = finalRoll;
          _isPlayerRolling = false;
        });
        _evaluatePlayerMoves();
      }
    });
  }

  void _evaluatePlayerMoves() {
    List<int> valid = [];
    for (int i = 0; i < 4; i++) {
      if (yellowPawns[i] == -1 && _playerDice == 6) {
        valid.add(i);
      } else if (yellowPawns[i] >= 0 && (yellowPawns[i] + _playerDice <= 56)) {
        valid.add(i);
      }
    }

    if (valid.isEmpty) {
      setState(() => _turnStatus = "কোনো চাল নেই! চাল মিস!");
      Future.delayed(const Duration(milliseconds: 1200), () => _passTurnToOpponent());
    } else {
      setState(() {
        _movablePawns = valid;
        _waitingForPawnTap = true;
        _turnStatus = "👉 চালার মতো ঘুঁটিতে ট্যাপ করুন!";
      });
    }
  }

  Future<void> _animatePawnStepByStep(int idx, int diceSteps, bool isYellow) async {
    setState(() => _isMovingStepByStep = true);

    if (isYellow ? yellowPawns[idx] == -1 : redPawns[idx] == -1) {
      await Future.delayed(const Duration(milliseconds: 180));
      setState(() {
        if (isYellow) yellowPawns[idx] = 0; else redPawns[idx] = 0;
      });
      HapticFeedback.selectionClick();
    } else {
      for (int s = 0; s < diceSteps; s++) {
        await Future.delayed(const Duration(milliseconds: 180));
        setState(() {
          if (isYellow) yellowPawns[idx]++; else redPawns[idx]++;
        });
        HapticFeedback.selectionClick();
      }
    }

    setState(() => _isMovingStepByStep = false);
  }

  Future<void> _onSelectPlayerPawn(int idx) async {
    if (!_waitingForPawnTap || !_movablePawns.contains(idx) || _isMovingStepByStep) return;
    HapticFeedback.lightImpact();

    setState(() {
      _waitingForPawnTap = false;
      _movablePawns.clear();
    });

    await _animatePawnStepByStep(idx, _playerDice, true);
    bool captured = _checkCapture(yellowPawns, idx, true);

    if (yellowPawns.every((p) => p == 56)) {
      _showVictoryDialog(true);
      return;
    }

    if (_playerDice == 6 || captured) {
      setState(() => _turnStatus = captured ? "💥 ঘুঁটি কেটেছেন! বোনাস চাল!" : "🎉 ছক্কা উঠেছে! আবার চালুন!");
      _startTurnTimer();
    } else {
      _passTurnToOpponent();
    }
  }

  bool _checkCapture(List<int> pawns, int pawnIdx, bool isYellow) {
    int stepVal = pawns[pawnIdx];
    if (stepVal >= 0 && stepVal < 51) {
      int myGlobal = getGlobalTileIndex(stepVal, isYellow);
      if (!safeGlobalTiles.contains(myGlobal)) {
        List<int> opp = isYellow ? redPawns : yellowPawns;
        for (int j = 0; j < 4; j++) {
          if (opp[j] >= 0 && opp[j] < 51) {
            int oppGlobal = getGlobalTileIndex(opp[j], !isYellow);
            if (myGlobal == oppGlobal) {
              setState(() => opp[j] = -1);
              HapticFeedback.heavyImpact();
              return true;
            }
          }
        }
      }
    }
    return false;
  }

  int getGlobalTileIndex(int stepVal, bool isYellow) {
    int startOffset = isYellow ? 27 : 1;
    return (startOffset + stepVal) % 52;
  }

  void _passTurnToOpponent() {
    _turnCountdownTimer?.cancel();
    setState(() {
      _turn = 1;
      _turnStatus = "প্রতিপক্ষ চাল দিচ্ছে...";
    });
    _startTurnTimer();
    Future.delayed(const Duration(milliseconds: 1000), () => _runOpponentTurn());
  }

  void _runOpponentTurn() {
    if (_turn != 1) return;
    setState(() => _isOpponentRolling = true);
    _opponentDiceRotCtrl.forward(from: 0.0);

    int count = 0;
    Timer.periodic(const Duration(milliseconds: 50), (timer) {
      count++;
      setState(() => _displayOpponentDice = Random().nextInt(6) + 1);
      if (count >= 10) {
        timer.cancel();
        final oppRoll = Random().nextInt(6) + 1;
        setState(() {
          _opponentDice = oppRoll;
          _displayOpponentDice = oppRoll;
          _isOpponentRolling = false;
        });

        Future.delayed(const Duration(milliseconds: 300), () => _executeOpponentMove());
      }
    });
  }

  Future<void> _executeOpponentMove() async {
    List<int> valid = [];
    for (int i = 0; i < 4; i++) {
      if (redPawns[i] == -1 && _opponentDice == 6) {
        valid.add(i);
      } else if (redPawns[i] >= 0 && (redPawns[i] + _opponentDice <= 56)) {
        valid.add(i);
      }
    }

    if (valid.isNotEmpty) {
      int chosen = valid.first;
      for (var idx in valid) {
        if (redPawns[idx] >= 0) {
          int nextStep = redPawns[idx] + _opponentDice;
          if (nextStep < 51) {
            int nextG = getGlobalTileIndex(nextStep, false);
            for (int y = 0; y < 4; y++) {
              if (yellowPawns[y] >= 0 && yellowPawns[y] < 51) {
                int yG = getGlobalTileIndex(yellowPawns[y], true);
                if (nextG == yG && !safeGlobalTiles.contains(nextG)) {
                  chosen = idx;
                  break;
                }
              }
            }
          }
        }
      }

      await _animatePawnStepByStep(chosen, _opponentDice, false);
      bool captured = _checkCapture(redPawns, chosen, false);

      if (redPawns.every((p) => p == 56)) {
        _showVictoryDialog(false);
        return;
      }

      if (_opponentDice == 6 || captured) {
        Future.delayed(const Duration(milliseconds: 1000), () => _runOpponentTurn());
        return;
      }
    }

    setState(() {
      _turn = 0;
      _turnStatus = "👉 আপনার চাল! ছক্কায় ট্যাপ করুন";
    });
    _startTurnTimer();
  }

  void _showVictoryDialog(bool playerWon) {
    _turnCountdownTimer?.cancel();
    if (playerWon) _recordWin();
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: const Color(0xFF4A0A3A),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20), side: const BorderSide(color: Colors.amber, width: 2)),
        title: Row(
          children: [
            Icon(playerWon ? Icons.emoji_events : Icons.sentiment_dissatisfied, color: Colors.amber, size: 30),
            const SizedBox(width: 10),
            Text(playerWon ? "বিজয়ী!" : "পরাজিত!", style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
          ],
        ),
        content: Text(
          playerWon ? "অভিনন্দন! আপনি ম্যাচটি জিতেছেন এবং ৳${(widget.entryFee * 1.8).toStringAsFixed(0)} পেয়েছেন!" : "দুঃখিত, প্রতিপক্ষ ম্যাচটি জিতে নিয়েছে!",
          style: const TextStyle(color: Colors.white70),
        ),
        actions: [
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: Colors.amber),
            onPressed: () {
              Navigator.pop(ctx);
              Navigator.pop(context);
            },
            child: const Text("লবিতে ফিরুন", style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold)),
          ),
        ],
      ),
    );
  }

