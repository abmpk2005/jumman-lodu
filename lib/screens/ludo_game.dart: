  Widget _buildRealisticPawn(Color color) {
    return Container(
      decoration: BoxDecoration(
        shape: BoxShape.circle,
        color: color,
        border: Border.all(color: Colors.white, width: 2),
        boxShadow: const [BoxShadow(color: Colors.black54, blurRadius: 4, offset: Offset(0, 2))],
      ),
      child: const Center(
        child: Icon(Icons.star, size: 14, color: Colors.white),
      ),
    );
  }

  Offset _getExactPawnOffset(int stepVal, bool isYellow, int slot, double step) {
    if (stepVal == -1) {
      if (isYellow) {
        final yellowPockets = [
          Offset(step * 1.8, step * 10.8),
          Offset(step * 3.8, step * 10.8),
          Offset(step * 1.8, step * 12.8),
          Offset(step * 3.8, step * 12.8),
        ];
        return yellowPockets[slot];
      } else {
        final redPockets = [
          Offset(step * 10.8, step * 1.8),
          Offset(step * 12.8, step * 1.8),
          Offset(step * 10.8, step * 3.8),
          Offset(step * 12.8, step * 3.8),
        ];
        return redPockets[slot];
      }
    }

    if (stepVal < 51) {
      int globalIdx = getGlobalTileIndex(stepVal, isYellow);
      final pt = trackPoints[globalIdx];
      return Offset((pt.x + 0.5) * step, (pt.y + 0.5) * step);
    }

    int h = stepVal - 51;
    if (isYellow) {
      return Offset(step * 7.5, (13.5 - h) * step);
    } else {
      return Offset(step * 7.5, (1.5 + h) * step);
    }
  }
}

class TrueLudoPainter extends CustomPainter {
  final double step;
  TrueLudoPainter({required this.step});

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()..style = PaintingStyle.fill;

    canvas.drawRect(Rect.fromLTWH(0, 0, size.width, size.height), Paint()..color = Colors.white);

    paint.color = const Color(0xFF1E88E5);
    canvas.drawRect(Rect.fromLTWH(0, 0, step * 6, step * 6), paint);

    paint.color = const Color(0xFFE53935);
    canvas.drawRect(Rect.fromLTWH(step * 9, 0, step * 6, step * 6), paint);

    paint.color = const Color(0xFFFBC02D);
    canvas.drawRect(Rect.fromLTWH(0, step * 9, step * 6, step * 6), paint);

    paint.color = const Color(0xFF2E7D32);
    canvas.drawRect(Rect.fromLTWH(step * 9, step * 9, step * 6, step * 6), paint);

    void drawBasePockets(double x, double y, Color c) {
      final rrect = RRect.fromRectAndRadius(Rect.fromLTWH(x + step * 0.8, y + step * 0.8, step * 4.4, step * 4.4), const Radius.circular(16));
      canvas.drawRRect(rrect, Paint()..color = Colors.white);

      final slotCoords = [
        Offset(x + step * 1.8, y + step * 1.8),
        Offset(x + step * 3.8, y + step * 1.8),
        Offset(x + step * 1.8, y + step * 3.8),
        Offset(x + step * 3.8, y + step * 3.8),
      ];
      for (var pt in slotCoords) {
        canvas.drawCircle(pt, step * 0.65, Paint()..color = c.withOpacity(0.15));
        canvas.drawCircle(pt, step * 0.65, Paint()..color = c..style = PaintingStyle.stroke..strokeWidth = 2);
      }
    }

    drawBasePockets(0, 0, const Color(0xFF1E88E5));
    drawBasePockets(step * 9, 0, const Color(0xFFE53935));
    drawBasePockets(0, step * 9, const Color(0xFFFBC02D));
    drawBasePockets(step * 9, step * 9, const Color(0xFF2E7D32));

    for (int r = 1; r <= 5; r++) {
      canvas.drawRect(Rect.fromLTWH(7 * step, r * step, step, step), Paint()..color = const Color(0xFFE53935));
    }
    for (int r = 9; r <= 13; r++) {
      canvas.drawRect(Rect.fromLTWH(7 * step, r * step, step, step), Paint()..color = const Color(0xFFFBC02D));
    }
    for (int c = 1; c <= 5; c++) {
      canvas.drawRect(Rect.fromLTWH(c * step, 7 * step, step, step), Paint()..color = const Color(0xFF1E88E5));
    }
    for (int c = 9; c <= 13; c++) {
      canvas.drawRect(Rect.fromLTWH(c * step, 7 * step, step, step), Paint()..color = const Color(0xFF2E7D32));
    }

    canvas.drawRect(Rect.fromLTWH(8 * step, 1 * step, step, step), Paint()..color = const Color(0xFFE53935));
    canvas.drawRect(Rect.fromLTWH(6 * step, 13 * step, step, step), Paint()..color = const Color(0xFFFBC02D));
    canvas.drawRect(Rect.fromLTWH(1 * step, 6 * step, step, step), Paint()..color = const Color(0xFF1E88E5));
    canvas.drawRect(Rect.fromLTWH(13 * step, 8 * step, step, step), Paint()..color = const Color(0xFF2E7D32));

    void drawStar(double c, double r) {
      final pt = Offset((c + 0.5) * step, (r + 0.5) * step);
      canvas.drawCircle(pt, step * 0.32, Paint()..color = Colors.black26);
    }

    drawStar(6, 2);
    drawStar(12, 6);
    drawStar(8, 12);
    drawStar(2, 8);

    final border = Paint()..style = PaintingStyle.stroke..color = Colors.black26..strokeWidth = 1.0;
    for (int r = 0; r < 15; r++) {
      for (int c = 0; c < 15; c++) {
        canvas.drawRect(Rect.fromLTWH(c * step, r * step, step, step), border);
      }
    }

    final center = Offset(step * 7.5, step * 7.5);
    canvas.drawPath(Path()..moveTo(step * 6, step * 6)..lineTo(step * 9, step * 6)..lineTo(center.dx, center.dy)..close(), Paint()..color = const Color(0xFFE53935));
    canvas.drawPath(Path()..moveTo(step * 6, step * 9)..lineTo(step * 9, step * 9)..lineTo(center.dx, center.dy)..close(), Paint()..color = const Color(0xFFFBC02D));
    canvas.drawPath(Path()..moveTo(step * 6, step * 6)..lineTo(step * 6, step * 9)..lineTo(center.dx, center.dy)..close(), Paint()..color = const Color(0xFF1E88E5));
    canvas.drawPath(Path()..moveTo(step * 9, step * 6)..lineTo(step * 9, step * 9)..lineTo(center.dx, center.dy)..close(), Paint()..color = const Color(0xFF2E7D32));
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class TrueDicePainter extends CustomPainter {
  final int dots;
  TrueDicePainter({required this.dots});

  @override
  void paint(Canvas canvas, Size size) {
    final pip = Paint()..color = Colors.white..style = PaintingStyle.fill;
    final shadow = Paint()..color = Colors.black38..style = PaintingStyle.fill;
    final r = size.width * 0.11;
    final w = size.width;
    final h = size.height;

    void drawDot(double x, double y) {
      canvas.drawCircle(Offset(x, y + 1.2), r, shadow);
      canvas.drawCircle(Offset(x, y), r, pip);
    }

    if (dots == 1) {
      drawDot(w * 0.5, h * 0.5);
    } else if (dots == 2) {
      drawDot(w * 0.28, h * 0.28);
      drawDot(w * 0.72, h * 0.72);
    } else if (dots == 3) {
      drawDot(w * 0.25, h * 0.25);
      drawDot(w * 0.5, h * 0.5);
      drawDot(w * 0.75, h * 0.75);
    } else if (dots == 4) {
      drawDot(w * 0.28, h * 0.28);
      drawDot(w * 0.72, h * 0.28);
      drawDot(w * 0.28, h * 0.72);
      drawDot(w * 0.72, h * 0.72);
    } else if (dots == 5) {
      drawDot(w * 0.28, h * 0.28);
      drawDot(w * 0.72, h * 0.28);
      drawDot(w * 0.5, h * 0.5);
      drawDot(w * 0.28, h * 0.72);
      drawDot(w * 0.72, h * 0.72);
    } else if (dots == 6) {
      drawDot(w * 0.28, h * 0.22);
      drawDot(w * 0.72, h * 0.22);
      drawDot(w * 0.28, h * 0.5);
      drawDot(w * 0.72, h * 0.5);
      drawDot(w * 0.28, h * 0.78);
      drawDot(w * 0.72, h * 0.78);
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}
